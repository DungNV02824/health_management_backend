# Health Management API Environment Variables
# Copy this file to .env and update the values

# Application Settings
APP_NAME="Health Management API"
APP_VERSION="1.0.0"
DEBUG=true
LOG_LEVEL=INFO

# Database Configuration
DATABASE_URL=postgresql://health_user:health_password@localhost:5432/health_management
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=20
DATABASE_POOL_TIMEOUT=30.0

# Security Settings
SECRET_KEY=8f6b2f397ddf1d59405a35222346b8b4
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# API Configuration
API_V1_PREFIX=/api/v1
ALLOWED_HOSTS=["*"]

# CORS Settings
CORS_ORIGINS=["*"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# Development Settings (set to false in production)
# These enable/disable API documentation endpoints
DOCS_ENABLED=true
